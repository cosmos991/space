OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional. When set, enter this same access code in the communications panel.
GAME_ACCESS_CODE=

# Optional image generation model (uses the same server-side API key).
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# NovelAI Account > Get Persistent API Token (never put this token in client code).
NOVELAI_API_TOKEN=
NOVELAI_IMAGE_MODEL=nai-diffusion-4-5-full
